# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Provedor exclusivo para relatórios: openai ou gemini
REPORT_AI_PROVIDER=openai
OPENAI_REPORT_MODEL=gpt-5
# Se o ChatGPT não responder, o Gemini assume automaticamente a geração.
REPORT_ALLOW_GEMINI_FALLBACK=true

# Armazenamento de figuras extraídas de PDFs/slides (Supabase Storage)
# Use apenas a chave publicável; nunca coloque senha PostgreSQL ou service_role aqui.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_STORAGE_BUCKET=materiais-estudo

# Model Tiers Configuration (fallbacks do app seguem a cascata Flash em src/shared/gemini-model-fallback.js)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_BALANCED=gemini-3.5-flash
MODEL_REASONING=gemini-3.6-flash
MODEL_CODE=gemini-3.6-flash
# Opcional: modelo prioritário apenas para contingência de relatórios.
REPORT_GEMINI_MODEL=gemini-3.7-flash

# Liberação do app por cupom (obrigatória para todos no ambiente publicado)
ACCESS_GATE_ENABLED=true
ACCESS_COUPON_CODE=replace_with_a_long_random_coupon
# 0 = sem limite de contas; cada UID ainda só pode ativar uma vez
ACCESS_COUPON_MAX_REDEMPTIONS=0
# 0 = acesso sem vencimento; valores maiores que 0 definem validade em dias
ACCESS_COUPON_ACCESS_DAYS=0
FIREBASE_PROJECT_ID=cobra-ai-6549d
# JSON da conta de serviço Firebase Admin, somente em secret/env seguro do servidor.
# Nunca use credencial Admin no navegador nem envie esse valor ao GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON=

# E-mails de anúncios (Resend). Configure somente nos secrets do Render.
# O domínio do remetente precisa estar verificado no Resend.
RESEND_API_KEY=
ANNOUNCEMENT_FROM_EMAIL=MedTutor Brasil <atualizacoes@seudominio.com.br>
# Gere um segredo aleatório forte; não reutilize chaves de Firebase/Gemini.
ANNOUNCEMENT_UNSUBSCRIBE_SECRET=
PUBLIC_SITE_URL=https://medtutorbrasil.com.br
