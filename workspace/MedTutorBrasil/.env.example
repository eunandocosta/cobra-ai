# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Provedor exclusivo para relatórios: openai ou gemini
REPORT_AI_PROVIDER=openai
OPENAI_REPORT_MODEL=gpt-5
# Mantenha false para nunca trocar silenciosamente de provedor em relatórios.
REPORT_ALLOW_GEMINI_FALLBACK=false

# Armazenamento de figuras extraídas de PDFs/slides (Supabase Storage)
# Use apenas a chave publicável; nunca coloque senha PostgreSQL ou service_role aqui.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_STORAGE_BUCKET=materiais-estudo

# Model Tiers Configuration (opcional)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_BALANCED=gemini-3.5-flash
MODEL_REASONING=gemini-3.5-pro
MODEL_CODE=gemini-3.5-pro
